# ============================================================================
# PDF Pipeline Configuration (REQUIRED for main.py)
# ============================================================================
# Path to the main PDF file - UPDATE THIS WITH YOUR ACTUAL PDF PATH
PIPELINE_MAIN_PDF=datas/Keputusan_Menteri_Dalam_Negeri_Nomor_300.2.2-2138_Tahun_2025.pdf

# Pipeline processing options
PIPELINE_BATCH_SIZE=38
PIPELINE_MAX_WORKERS=7
PIPELINE_DEBUG_MODE=False
PIPELINE_FORCE_RESTRUCTURE=False

# Directory paths (relative to src/)
PIPELINE_DATA_DIRECTORY=datas
PIPELINE_OUTPUT_DIRECTORY=output
PIPELINE_DEBUG_DIRECTORY=debug
PIPELINE_LOG_DIRECTORY=log

# Logging configuration
PIPELINE_LOG_LEVEL=INFO
LOG_LEVEL=INFO
LOG_DIRECTORY=log

# LLM Provider Configuration Examples
# Copy this file to .env and configure your preferred provider

# ============================================================================
# LLM Provider Selection
# ============================================================================
# Options: openai, anthropic, google, gemini, azure, ollama, bedrock, mistral
LLM_PROVIDER=openai

# ============================================================================
# Model Configuration (Provider-Specific)
# ============================================================================
# OpenAI: gpt-4-turbo-preview, gpt-4, gpt-3.5-turbo
# Anthropic: claude-3-opus-20240229, claude-3-sonnet-20240229, claude-3-haiku-20240307
# Google: gemini-pro, gemini-1.5-pro
# Ollama: llama3, mistral, mixtral, etc.
# Mistral AI: mistral-large-latest, mistral-medium, mistral-small
LLM_MODEL=gpt-4-turbo-preview

# ============================================================================
# API Keys (Provider-Specific)
# ============================================================================
# OpenAI
OPENAI_API_KEY=your-openai-api-key-here

# Anthropic
ANTHROPIC_API_KEY=your-anthropic-api-key-here

# Google
GOOGLE_API_KEY=your-google-api-key-here

# Mistral AI
MISTRAL_API_KEY=your-google-api-key-here

# Azure OpenAI
AZURE_API_KEY=your-azure-api-key-here
AZURE_API_BASE=https://your-resource.openai.azure.com
AZURE_API_VERSION=2024-02-15-preview

# ============================================================================
# Local Model Configuration (Ollama, LM Studio, etc.)
# ============================================================================
# LLM_BASE_URL=http://localhost:11434  # Ollama default
# LLM_BASE_URL=http://localhost:1234/v1  # LM Studio default
# LLM_BASE_URL=https://api.mistral.ai

# ============================================================================
# Generation Parameters
# ============================================================================
# Temperature: 0.0 = deterministic, 1.0 = creative
LLM_TEMPERATURE=0.1

# Max tokens for response (leave empty to use model's default context window)
LLM_MAX_TOKENS=16384

# ============================================================================
# Confidence Thresholds
# ============================================================================
# Minimum confidence for auto-apply (0.0-1.0)
CONFIDENCE_THRESHOLD_AUTO_APPLY=0.80

# Minimum confidence before flagging as low (0.0-1.0)
CONFIDENCE_THRESHOLD_FLAG=0.70

# ============================================================================
# Output Configuration
# ============================================================================
OUTPUT_MARKDOWN_DIR=src/datas/comparing_pos
OUTPUT_JSON_DIR=src/datas/comparing_pos
OUTPUT_LOG_DIR=src/log
